# Configuração do Cliente Google
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Código para o vinculo entre usuarios
# Use no terminal: 
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODIGO_VINCULO_SECRET=gere_uma_chave_com_o_comando_indicado

EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_do_google